{
  "name": "opencode-sessions-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "PORT=4174 tsx server/index.ts",
    "dev:web": "ng serve --host 127.0.0.1 --port 4173 --proxy-config proxy.conf.json",
    "build": "npm run typecheck:server && ng build",
    "test": "ng test --no-watch --no-progress && npm run test:server",
    "test:server": "vitest run server/data/session-search.spec.ts server/services/session-cleanup.service.spec.ts server/services/database-maintenance.service.spec.ts",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@opencode/client": "^2.2.5",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
